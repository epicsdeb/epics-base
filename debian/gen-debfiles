#!/usr/bin/make -f

TOP = .

#base version
include $(TOP)/configure/CONFIG_BASE_VERSION
epics_LIBVERSION = $(EPICS_VERSION)
epics_VERSION_STRING = $(EPICS_SHORT_VERSION)

#libca version
include $(TOP)/configure/CONFIG_CA_VERSION
ca_LIBVERSION = $(EPICS_CA_MAJOR_VERSION)
ca_VERSION_STRING = $(EPICS_CA_MAJOR_VERSION).$(EPICS_CA_MINOR_VERSION).$(EPICS_CA_MAINTENANCE_VERSION)

#libcom version
include $(TOP)/configure/CONFIG_LIBCOM_VERSION
com_LIBVERSION = $(EPICS_LIBCOM_MAJOR_VERSION)
com_VERSION_STRING = $(EPICS_LIBCOM_MAJOR_VERSION).$(EPICS_LIBCOM_MINOR_VERSION).$(EPICS_LIBCOM_MAINTENANCE_VERSION)

#libdbcore version
include $(TOP)/configure/CONFIG_DATABASE_VERSION
dbcore_LIBVERSION = $(EPICS_DATABASE_MAJOR_VERSION)
dbcore_VERSION_STRING = $(EPICS_DATABASE_MAJOR_VERSION).$(EPICS_DATABASE_MINOR_VERSION).$(EPICS_DATABASE_MAINTENANCE_VERSION)

#libnt version
include $(TOP)/modules/normativeTypes/configure/CONFIG_NTYPES_VERSION
nt_LIBVERSION = $(EPICS_NTYPES_MAJOR_VERSION)
nt_VERSION_STRING = $(EPICS_NTYPES_MAJOR_VERSION).$(EPICS_NTYPES_MINOR_VERSION).$(EPICS_NTYPES_MAINTENANCE_VERSION)

#libqsrv version
include $(TOP)/modules/pva2pva/configure/CONFIG_QSRV_VERSION
qsrv_LIBVERSION = $(EPICS_QSRV_MAJOR_VERSION)
qsrv_VERSION_STRING = $(EPICS_QSRV_MAJOR_VERSION).$(EPICS_QSRV_MINOR_VERSION).$(EPICS_QSRV_MAINTENANCE_VERSION)

#libpvaccess version
include $(TOP)/modules/pvAccess/configure/CONFIG_PVACCESS_VERSION
pva_LIBVERSION = $(EPICS_PVA_MAJOR_VERSION)
pva_VERSION_STRING = $(EPICS_PVA_MAJOR_VERSION).$(EPICS_PVA_MINOR_VERSION).$(EPICS_PVA_MAINTENANCE_VERSION)

#libpvaclient version
include $(TOP)/modules/pvaClient/configure/CONFIG_PVACLIENT_VERSION
pvaclient_LIBVERSION = $(EPICS_PVACLIENT_MAJOR_VERSION)
pvaclient_VERSION_STRING = $(EPICS_PVACLIENT_MAJOR_VERSION).$(EPICS_PVACLIENT_MINOR_VERSION).$(EPICS_PVACLIENT_MAINTENANCE_VERSION)

#libpvdata version
include $(TOP)/modules/pvData/configure/CONFIG_PVDATA_VERSION
pvdata_LIBVERSION = $(EPICS_PVD_MAJOR_VERSION)
pvdata_VERSION_STRING = $(EPICS_PVD_MAJOR_VERSION).$(EPICS_PVD_MINOR_VERSION).$(EPICS_PVD_MAINTENANCE_VERSION)

#libpvdatabase version
include $(TOP)/modules/pvDatabase/configure/CONFIG_PVDATABASE_VERSION
pvdatabase_LIBVERSION = $(EPICS_PVDATABASE_MAJOR_VERSION)
pvdatabase_VERSION_STRING = $(EPICS_PVDATABASE_MAJOR_VERSION).$(EPICS_PVDATABASE_MINOR_VERSION).$(EPICS_PVDATABASE_MAINTENANCE_VERSION)

MODULES      = ca com    dbcore   nt             qsrv    pva      pvaclient pvdata pvdatabase epics
BINMODULES   = epics-catools epics-commontools epics-dbtools epics-nttools epics-qsrvtools epics-pvatools epics-pvaclienttools epics-pvdatatools epics-pvdatabasetools epics-tools
MODULES_DIRS = ca libcom database normativeTypes pva2pva pvAccess pvaClient pvData pvDatabase src

define GEN_SUBSTVARS_RULE
lib$(1)$($(1)_LIBVERSION).substvars:
	@printf 'lib$(1):UpstreamVersion?=%s\nlib$(1):MajorVersion?=%s\n' '$$($(1)_VERSION_STRING)' '$$($(1)_LIBVERSION)' > $$@
endef
$(foreach m,$(MODULES),$(eval $(call GEN_SUBSTVARS_RULE,$(m))))

define GEN_INSTALL_FILE_RULE
$(1).install:
	python3 debian/generate_install_file.py $(1) $(2)
endef

define GEN_LINKS_RULE
$(1).links: $(1).install
	python3 debian/generate_links_file.py $(1) $(2)
endef

VERSIONED_MODULES := $(foreach m,$(MODULES),lib$(m)$($(m)_LIBVERSION))
SUBSTVARS_FILES := $(foreach m,$(VERSIONED_MODULES),$(m).substvars)
SHLIB_INSTALL_FILES := $(foreach m,$(VERSIONED_MODULES),$(m).install)

DEV_PACKAGES := $(foreach m,$(MODULES),lib$(m)-dev)
DEV_PACKAGES := $(filter-out libepics-dev,$(DEV_PACKAGES))
DEV_PACKAGES += epics-dev

DEV_INSTALL_FILES := $(foreach m,$(DEV_PACKAGES),$(m).install)

BIN_INSTALL_FILES := $(foreach m,$(BINMODULES),$(m).install)

SHLIB_LINKS_FILES := $(foreach m,$(VERSIONED_MODULES),$(m).links)

ALL_INSTALL_FILES_WITH_PREFIX := $(foreach f, $(SHLIB_INSTALL_FILES) $(DEV_INSTALL_FILES) $(BIN_INSTALL_FILES), debian/$(f))

$(foreach i, $(shell seq 1 $(words $(VERSIONED_MODULES))), \
		$(eval $(call GEN_INSTALL_FILE_RULE, $(word $(i),$(VERSIONED_MODULES)), $(word $(i), $(MODULES_DIRS))));\
		$(eval $(call GEN_INSTALL_FILE_RULE, $(word $(i),$(BINMODULES)), $(word $(i), $(MODULES_DIRS))));\
		$(eval $(call GEN_INSTALL_FILE_RULE, $(word $(i),$(DEV_PACKAGES)), $(word $(i), $(MODULES_DIRS))));\
		$(eval $(call GEN_LINKS_RULE, $(word $(i),$(VERSIONED_MODULES)), $(word $(i),$(DEV_PACKAGES))));)

.PHONY: substvars
substvars: $(SUBSTVARS_FILES)

libinstallfiles: $(SHLIB_INSTALL_FILES)

devinstallfiles: $(DEV_INSTALL_FILES)

bininstallfiles: $(BIN_INSTALL_FILES)

installfiles: libinstallfiles devinstallfiles bininstallfiles

links: $(SHLIB_LINKS_FILES)

.PHONY: test
test:
	@echo $(VERSIONED_MODULES)

clean:
	$(RM) $(ALL_INSTALL_FILES_WITH_PREFIX)
	$(RM) $(foreach f, $(DEV_PACKAGES) $(VERSIONED_MODULES), debian/$(f).links)